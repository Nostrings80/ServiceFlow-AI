DATABASE_URL="file:./dev.db"
JWT_SECRET="replace-with-a-long-random-string"

# Optional — enables the "On my way" feature (traffic-aware routing + customer SMS).
# The app runs fine without these; it just skips routing/SMS and says why.

# Google Cloud API key with the "Routes API" and "Geocoding API" enabled.
# https://console.cloud.google.com/apis/library
GOOGLE_MAPS_API_KEY=""

# Twilio account for outbound SMS. https://console.twilio.com
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER="" # a Twilio number in E.164 format, e.g. +15551234567
